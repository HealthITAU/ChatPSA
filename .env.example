# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── ConnectWise Manage API (required) ────────────────────────────────────────
# These can be set here OR in ~/.config/connectwise/cw_config.json on the host.
CW_SITE=cw.yourcompany.com
CW_COMPANY_ID=yourcompany
CW_PUBLIC_KEY=your-public-key
CW_PRIVATE_KEY=your-private-key
CW_CLIENT_ID=your-client-id-guid

# ── Microsoft Entra ID / Azure AD OAuth (optional) ──────────────────────────
# Set all three to enable Microsoft login. Leave commented for no-auth local mode.
#
# To set up:
# 1. Go to https://entra.microsoft.com → App registrations → New registration
# 2. Name: "ChatPSA"
# 3. Supported account types: "Accounts in this organizational directory only"
# 4. Redirect URI: Web → https://your-domain.com/auth/callback
# 5. Under Certificates & Secrets → New client secret → copy the Value
# 6. Copy Application (client) ID and Directory (tenant) ID from Overview
#
# If running both production and staging, add both callback URLs to the same
# App Registration under Authentication → Redirect URIs.
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=your-secret-value
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── CIPP / Microsoft 365 API (optional) ─────────────────────────────────────
# Enables M365 tenant, license, and alert syncing via CIPP.
# Credentials are visible in CIPP under Settings → Backend → SAM Setup.
# See: https://docs.cipp.app/user-documentation/cipp/settings/backend
#
# Required (all three to enable):
#   CIPP_API_URL       — base URL of your CIPP API Azure Function
#   CIPP_CLIENT_ID     — app registration client ID
#   CIPP_CLIENT_SECRET — client secret for the app registration
#
# Token URL — provide one of:
#   CIPP_TOKEN_URL     — full OAuth2 token endpoint URL (preferred)
#   CIPP_TENANT_ID     — your MSP's Azure tenant ID (constructs token URL)
#
# Optional:
#   CIPP_SCOPE         — OAuth2 scope; auto-derived from CIPP_CLIENT_ID if not set
# CIPP_API_URL=https://cipp-api.azurewebsites.net
# CIPP_TOKEN_URL=
# CIPP_TENANT_ID=
# CIPP_CLIENT_ID=
# CIPP_CLIENT_SECRET=
# CIPP_SCOPE=

# ── Duo Security Admin API (optional) ───────────────────────────────────────
# Syncs MFA user enrollment and status. Create an "Admin API" application in
# Duo Admin Panel → Applications with "Grant read resource" permission.
# DUO_IKEY=
# DUO_SKEY=
# DUO_HOST=api-XXXXXXXX.duosecurity.com

# ── Huntress EDR API (optional) ────────────────────────────────────────────
# Syncs Huntress organisations, agents, and incident reports.
# Generate API credentials at https://huntress.io/ → API Credentials.
# HUNTRESS_API_KEY=
# HUNTRESS_API_SECRET=

# ── ThreatLocker API (optional) ────────────────────────────────────────────
# Syncs ThreatLocker endpoint inventory and security mode.
# Use a parent-level portal API key (not per-organisation).
# THREATLOCKER_API_KEY=


# ── Deployment ─────────────────────────────────────────────────────────────
# Host port that Docker maps to the container's internal port 5001.
# Your reverse proxy (Apache/nginx) should point to this port.
# APP_PORT=5001

# ── App identity ───────────────────────────────────────────────────────────
# Display name shown in the UI and used in the AI system prompt.
# APP_NAME=ChatPSA

# Base URL for contextual documentation links in the admin UI.
# Set to the raw-browsable root of your repository. Leave commented to hide
# documentation links. See docs/administration.md#documentation-links.
# DOCS_BASE_URL=https://github.com/yourorg/ChatPSA/blob/main

# IANA timezone name. Handles DST automatically. See docs/timezone.md.
# Examples: Australia/Brisbane, America/New_York, Europe/London, UTC.
# APP_TZ_NAME=Australia/Brisbane
# Legacy: APP_TZ_OFFSET=10 (numeric UTC offset) is still accepted as a
# fallback if APP_TZ_NAME is not set, but does not handle DST.

# ── Settings management ─────────────────────────────────────────────────────
# Many settings above (APP_NAME, HELPDESK_BOARD, APP_TZ_NAME, Claude model,
# etc.) can also be managed via the Admin → Settings page in the web UI.
#
# By default, env vars seed the database on first boot; after that the DB
# value wins and admins can change settings without redeploying.
#
# Set ENV_OVERRIDE=true to force configurable settings to read from env vars,
# taking precedence over the database. Settings whose env var is commented out
# or missing continue to read from the database — only vars explicitly present
# in the environment are overridden.
#
# IMPORTANT: With ENV_OVERRIDE, a var set to empty (VAR=) writes an empty
# string to the database, clearing that setting. Comment out vars you don't
# want to change rather than leaving them empty.
# ENV_OVERRIDE=true

# ── App settings ────────────────────────────────────────────────────────────
# Secret key for Flask session cookies. Auto-generated and persisted to
# /data/.secret_key if not set. MUST be different per environment so that
# production and staging session cookies don't collide.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# Database path inside the Docker container. The /data volume is shared
# between the web app and all sync containers.
CW_DB_PATH=/data/cw_data.db

# Name of the primary helpdesk board in ConnectWise.
# HELPDESK_BOARD=Help Desk

# Company name(s) to exclude from trend/anomaly queries (comma-separated).
# Set to the MSP's own company name so internal tickets don't skew trends.
# TRENDS_EXCLUDE_COMPANIES=YourMSP,Your MSP Name

# Priority names that trigger the "stale high-priority ticket" anomaly
# (comma-separated). If not set, any priority containing "Critical" or "High"
# is matched automatically.
# TRENDS_HIGH_PRIORITIES=Priority 1 - Critical,Priority 2 - High

# ── Claude model (optional) ─────────────────────────────────────────────────
# Override the default model and max tokens. Useful for testing newer models
# or adjusting response length.
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_TOKENS=4096

# ── Timeline (optional) ────────────────────────────────────────────────────
# Generate AI summaries for timeline events during sync. Set to false to save
# API costs or if summaries aren't needed.
# TIMELINE_AI_SUMMARIES=true

# Comma-separated list of ConnectWise board names to include in the timeline.
# Leave commented to include all boards.
# TIMELINE_BOARDS=

# ── Sync behaviour (optional) ──────────────────────────────────────────────
# Skip the initial full sync on container startup if the database already
# has data. Useful in development to avoid waiting for a full sync.
# SKIP_INITIAL_SYNC=true

# ── Logging (optional) ──────────────────────────────────────────────────────
# LOG_LEVEL=INFO
